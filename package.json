{
  "name": "stories",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "stories monorepo：根 = 后端 + 数据服务（scraper/deploy/public），web/ = 冻结的 web UI，mobile/ = 主力 Expo/RN App",
  "scripts": {
    "dev": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "preview": "npm run preview --prefix web",
    "scrape": "node scraper/zhihu-feed.mjs && npm run sync:zhihu && node scraper/bilibili-feed.mjs && npm run sync:bilibili && node scraper/github-trending.mjs && npm run sync:github && node scraper/weibo-hot.mjs && npm run sync:weibo && node scraper/hn-hot.mjs && npm run sync:hn",
    "scrape:zhihu": "node scraper/zhihu-feed.mjs && npm run sync:zhihu",
    "scrape:github": "node scraper/github-trending.mjs && npm run sync:github",
    "scrape:weibo": "node scraper/weibo-hot.mjs && npm run sync:weibo",
    "scrape:hn": "node scraper/hn-hot.mjs && npm run sync:hn",
    "scrape:login": "node scraper/login-qr-png.mjs",
    "scrape:login:bilibili": "node scraper/login-qr-png.mjs --site bilibili",
    "scrape:login:lightpanda": "node scraper/login-qr-png.mjs --browser lightpanda",
    "scrape:bilibili": "node scraper/bilibili-feed.mjs && npm run sync:bilibili",
    "sync:zhihu": "node scripts/sync-zhihu.mjs && chmod -R a+rX public/data",
    "sync:bilibili": "node scripts/sync-bilibili.mjs && chmod -R a+rX public/data",
    "sync:github": "node scripts/sync-github.mjs && chmod -R a+rX public/data",
    "sync:weibo": "node scripts/sync-weibo.mjs && chmod -R a+rX public/data",
    "sync:hn": "node scripts/sync-hn.mjs && chmod -R a+rX public/data",
    "tag:zhihu": "node scraper/tagger.mjs --source zhihu",
    "tag:bilibili": "node scraper/tagger.mjs --source bilibili",
    "tag:github": "node scraper/tagger.mjs --source github",
    "tag:weibo": "node scraper/tagger.mjs --source weibo",
    "tag:hn": "node scraper/tagger.mjs --source hn",
    "summarize:github": "node scraper/github-summarizer.mjs",
    "profile": "node scraper/profile-engine.mjs",
    "rank": "node scraper/ranker.mjs && chmod -R a+rX public/data",
    "likes:sync": "node scraper/like-sync.mjs",
    "api:start": "bash deploy/start-api.sh",
    "api:dev": "node deploy/api.mjs",
    "schedule": "node scraper/scheduler.mjs",
    "schedule:start": "node scraper/scheduler.mjs --daemon",
    "schedule:stop": "node scraper/scheduler.mjs --stop"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
